# Flock server the app talks to. Leave unset on web to use the same origin (Docker/nginx)
# or http://<host>:4000 when running the Expo dev server on :8081.
# Android emulator -> host machine: http://10.0.2.2:4000 ; physical phone -> http://<your-LAN-IP>:4000
EXPO_PUBLIC_API_URL=

# STUN/TURN servers for calls come from the Flock server (GET /api/ice), not from the app build.
