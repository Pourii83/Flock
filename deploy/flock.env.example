# Flock server configuration (/etc/flock/flock.env). Restart after editing:
#   sudo systemctl restart flock
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://flock:CHANGE_ME@127.0.0.1:5432/flock
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Built PWA served by the same process (remove to run API-only)
WEB_DIR=/opt/flock/web
# Comma-separated allowed origins, or * (needed for the desktop/mobile apps)
CORS_ORIGIN=*
# Where profile photos are stored (systemd sets /var/lib/flock/uploads by default)
# UPLOAD_DIR=/var/lib/flock/uploads
# Original chat attachments are deleted after this many days (messages remain)
FILE_RETENTION_DAYS=7
# Largest file people can send, in MB (behind Nginx, client_max_body_size must be a bit larger)
MAX_UPLOAD_MB=100

# TURN relay for calls between different networks (see INSTALL.md "TURN server")
# TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp,turns:chat.example.com:5349?transport=tcp
# TURN_SECRET=<same value as static-auth-secret in /etc/turnserver.conf>
