{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../README.md ../README.fa.md ../docs/screenshots .",
  "headers": [
    { "source": "/screenshots/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=86400" }] }
  ]
}
