# Copy to .env and change before deploying:  cp .env.example .env
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_USER=flock
POSTGRES_PASSWORD=flock
POSTGRES_DB=flock

# Host ports
WEB_PORT=8080
SERVER_PORT=4000

# Comma-separated allowed origins for the API (use your domain in production)
CORS_ORIGIN=*

# Optional TURN relay for calls across strict NATs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
