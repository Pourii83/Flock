# Copy to .env and change before deploying:  cp .env.example .env
JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_USER=flock
POSTGRES_PASSWORD=flock
POSTGRES_DB=flock

# Host ports
WEB_PORT=8080
SERVER_PORT=4000

# Comma-separated allowed origins for the API (use your domain in production)
CORS_ORIGIN=*

# Optional TURN relay (coturn with use-auth-secret) for calls across different networks
# TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# TURN_SECRET=
# More relays sharing TURN_SECRET (e.g. eturnal on another server), tried before TURN_URLS:
# TURN_EXTRA_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Send all call media through the relay (hides users' IPs; uses the relay's bandwidth):
# TURN_RELAY_ONLY=1
